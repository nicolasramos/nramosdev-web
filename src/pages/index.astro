---
import Base from '../layouts/Base.astro';
import {getCollection} from 'astro:content';

const posts = (await getCollection('posts', ({data}) => data.lang === 'es' && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base lang="es" title="NRamosDev — IA y tecnología en español" description="Blog de Nicolás Ramos sobre inteligencia artificial, modelos de lenguaje y desarrollo de software. Cada vídeo del canal tiene su análisis por escrito.">
  <section class="pb-16 pt-24 text-center">
    <p class="font-mono text-3xl font-black tracking-tight sm:text-4xl">
      <span class="text-black">(</span><span class="text-black">[</span>nr<span class="text-black">]</span><span class="text-black">)</span>
    </p>
    <h1 class="mt-6 text-4xl font-black uppercase leading-tight tracking-tight sm:text-6xl">
      IA y tecnología<br /><span class="text-black">sin humo</span>
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-neutral-600">
      Análisis de modelos de lenguaje, agentes IA y desarrollo de software. Cada vídeo del canal{' '}
      <a href="https://www.youtube.com/@nramosdev" target="_blank" rel="noopener" class="text-black underline decoration-black underline-offset-4 hover:opacity-80">nramosdev</a>{' '}
      tiene aquí su artículo con el contexto completo.
    </p>
  </section>

  <section>
    <h2 class="mb-8 text-sm font-black uppercase tracking-[0.3em] text-neutral-600">Artículos</h2>
    <div class="grid gap-6">
      {posts.map((post) => (
        <a href={`/blog/${post.id.replace(/^(es|en)-/, '')}`} class="group block rounded-xl border border-black/10 bg-neutral-50 p-8 transition hover:border-black/60 hover:bg-neutral-100">
          <div class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-widest text-neutral-600">
            <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('es-ES', {day: 'numeric', month: 'long', year: 'numeric'})}</time>
            {post.data.duration && <span class="rounded-full border border-black/15 px-2 py-0.5">▶ {post.data.duration}</span>}
            {post.data.tags.slice(0, 3).map((tag) => <span class="text-black">#{tag}</span>)}
          </div>
          <h3 class="mt-4 text-2xl font-black leading-snug transition group-hover:text-black">{post.data.title}</h3>
          <p class="mt-3 line-clamp-2 text-neutral-600">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
