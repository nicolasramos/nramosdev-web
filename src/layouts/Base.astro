---
interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en';
}
const {title, description, lang} = Astro.props;
const t = {
  es: {home: 'Inicio', blog: 'Blog', nav: 'Artículos', suscribe: 'Suscríbete en YouTube'},
  en: {home: 'Home', blog: 'Blog', nav: 'Posts', suscribe: 'Subscribe on YouTube'},
}[lang];
const altLang = lang === 'es' ? 'en' : 'es';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <style>@import '../styles/global.css';</style>
  </head>
  <body class="bg-white text-black antialiased">
    <header class="sticky top-0 z-40 border-b border-black/10 bg-white/90 backdrop-blur">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a href={lang === 'es' ? '/' : '/en/'} class="font-mono text-2xl font-black tracking-tight" aria-label="NRamosDev">
          <span class="text-black">(</span><span class="text-black">[</span>nr<span class="text-black">]</span><span class="text-black">)</span>
        </a>
        <div class="flex items-center gap-6 text-sm font-bold uppercase tracking-widest text-neutral-600">
          <a href={lang === 'es' ? '/blog' : '/en/blog'} class="transition hover:text-black">{t.nav}</a>
          <a href="https://www.youtube.com/@nramosdev" target="_blank" rel="noopener" class="transition hover:text-black">{t.suscribe}</a>
          <a href={lang === 'es' ? '/en/' : '/'} class="rounded-full border border-black/20 px-3 py-1 text-xs transition hover:border-black">{altLang.toUpperCase()}</a>
        </div>
      </nav>
    </header>
    <main class="mx-auto max-w-5xl px-6">
      <slot />
    </main>
    <footer class="mx-auto mt-24 max-w-5xl border-t border-black/10 px-6 py-10">
      <div class="flex flex-col items-center justify-between gap-4 text-sm text-neutral-600 sm:flex-row">
        <span class="font-mono font-bold">([nr]) — NRamosDev</span>
        <div class="flex gap-5">
          <a href="https://github.com/nicolasramos" target="_blank" rel="noopener" class="transition hover:text-black">GitHub</a>
          <a href="https://www.linkedin.com/in/nramosdev" target="_blank" rel="noopener" class="transition hover:text-black">LinkedIn</a>
          <a href="https://www.youtube.com/@nramosdev" target="_blank" rel="noopener" class="transition hover:text-black">YouTube</a>
          <a href="mailto:hola@nicolasramos.es" class="transition hover:text-black">Contacto</a>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-neutral-500">
        <a href={lang === 'es' ? '/privacidad' : '/en/privacy'} class="transition hover:text-black">Política de privacidad</a>
        <a href={lang === 'es' ? '/cookies' : '/en/cookies'} class="transition hover:text-black">Política de cookies</a>
        <a href={lang === 'es' ? '/aviso-legal' : '/en/legal'} class="transition hover:text-black">Aviso legal</a>
        <span>·</span>
        <span>Alojado en la UE · RGPD</span>
      </div>
    </footer>
  </body>
</html>
