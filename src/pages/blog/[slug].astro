---
import Base from '../../layouts/Base.astro';
import {getCollection, render} from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({data}) => data.lang === 'es' && !data.draft);
  return posts.map((post) => ({params: {slug: post.id.replace(/^(es|en)-/, '')}, props: {post}}));
}

const {post} = Astro.props;
const {Content} = await render(post);
---

<Base lang="es" title={`${post.data.title} — NRamosDev`} description={post.data.description}>
  <article class="mx-auto max-w-3xl py-16">
    <div class="mb-10 text-center">
      <div class="text-xs font-black uppercase tracking-[0.3em] text-neutral-600">NRamosDev · Blog</div>
      <h1 class="mt-4 text-4xl font-black leading-tight">{post.data.title}</h1>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-3 text-xs font-bold uppercase tracking-widest text-neutral-600">
        <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('es-ES', {day: 'numeric', month: 'long', year: 'numeric'})}</time>
        {post.data.tags.map((tag) => <span class="text-black">#{tag}</span>)}
      </div>
    </div>

    {post.data.videoId && post.data.videoId !== 'PENDIENTE' && (
      <div class="mb-12 aspect-video overflow-hidden rounded-xl border border-black/10">
        <iframe
          class="h-full w-full"
          src={`https://www.youtube.com/embed/${post.data.videoId}`}
          title={post.data.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    )}

    <div class="prose prose-headings:font-black prose-headings:uppercase prose-headings:tracking-tight prose-a:text-black prose-strong:text-black max-w-none">
      <Content />
    </div>

    <div class="mt-16 rounded-xl border border-black/10 bg-neutral-50 p-8 text-center">
      <p class="font-mono text-xl font-black">([nr])</p>
      <p class="mt-3 text-neutral-600">¿Te ha gustado? Suscríbete al canal para más análisis de IA en español.</p>
      <a href="https://www.youtube.com/@nramosdev" target="_blank" rel="noopener" class="mt-5 inline-block rounded-lg bg-black px-6 py-3 text-sm font-black uppercase tracking-widest text-black transition hover:opacity-70">
        Ver en YouTube
      </a>
    </div>
  </article>
</Base>
