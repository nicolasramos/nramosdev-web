---
interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en';
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}
const {title, description, lang, ogImage, ogType = 'website', jsonLd} = Astro.props;
const t = {
  es: {nav: 'Artículos', suscribe: 'Suscríbete en YouTube'},
  en: {nav: 'Posts', suscribe: 'Subscribe on YouTube'},
}[lang];
const altLang = lang === 'es' ? 'en' : 'es';

const SITE = 'https://nramos.dev';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '';
// Canonical: la ruta pública de esta página (la lengua por defecto va sin prefijo)
const canonicalPath = lang === 'en' ? pathname : (pathname === '' ? '/' : pathname);
const canonical = `${SITE}${canonicalPath || '/'}`;
// Hreflang alternate: la misma página en la otra lengua
const alternatePath =
  lang === 'en'
    ? (pathname.replace(/^\/en/, '') || '/')
    : `/en${pathname === '/' ? '' : pathname}`;
const alternate = `${SITE}${alternatePath === '/' ? '/' : alternatePath}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={altLang} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta property="og:site_name" content="NRamosDev" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <meta name="theme-color" content="#0b0e11" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <style>@import '../styles/global.css';</style>
    <style is:global>@import '../styles/prose.css';</style>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="bg-bg text-fg antialiased">
    <div class="bg-noir" aria-hidden="true"></div>

    <header class="sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur-md">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a href={lang === 'es' ? '/' : '/en/'} class="font-mono text-2xl font-extrabold tracking-tight" aria-label="NRamosDev">
          <span class="text-fg">(</span><span class="text-amber">[</span><span class="text-fg">nr</span><span class="text-amber">]</span><span class="text-fg">)</span><span class="ml-0.5 inline-block h-[1em] w-[0.55ch] translate-y-[0.12em] bg-amber animate-blink" aria-hidden="true"></span>
        </a>
        <div class="flex items-center gap-5 text-xs font-bold uppercase tracking-[0.18em] text-muted sm:gap-7">
          <a href={lang === 'es' ? '/blog' : '/en/blog'} class="transition hover:text-amber">{t.nav}</a>
          <a href="https://www.youtube.com/@nramosdev" target="_blank" rel="noopener" class="transition hover:text-amber">{t.suscribe}</a>
          <a href={lang === 'es' ? '/en/' : '/'} class="rounded-full border border-line px-3 py-1 text-[0.7rem] transition hover:border-amber hover:text-amber">{altLang.toUpperCase()}</a>
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-5xl px-6">
      <slot />
    </main>

    <footer class="mt-24 border-t border-line/70">
      <div class="mx-auto max-w-5xl px-6 py-10">
        <div class="flex flex-col items-center justify-between gap-4 text-sm text-muted sm:flex-row">
          <span class="font-mono font-bold text-fg">([nr])</span>
          <span class="font-mono text-xs text-muted/70">~/nramos.dev — {new Date().getFullYear()}</span>
          <div class="flex gap-5">
            <a href="https://github.com/nicolasramos" target="_blank" rel="noopener" class="transition hover:text-amber">GitHub</a>
            <a href="https://www.linkedin.com/in/nramosdev" target="_blank" rel="noopener" class="transition hover:text-amber">LinkedIn</a>
            <a href="https://www.youtube.com/@nramosdev" target="_blank" rel="noopener" class="transition hover:text-amber">YouTube</a>
            <a href="mailto:hola@nicolasramos.es" class="transition hover:text-amber">Contacto</a>
          </div>
        </div>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-muted/70">
          <a href={lang === 'es' ? '/privacidad' : '/en/privacy'} class="transition hover:text-amber">Política de privacidad</a>
          <a href={lang === 'es' ? '/cookies' : '/en/cookies'} class="transition hover:text-amber">Política de cookies</a>
          <a href={lang === 'es' ? '/aviso-legal' : '/en/legal'} class="transition hover:text-amber">Aviso legal</a>
          <span aria-hidden="true">·</span>
          <span>Alojado en la UE · RGPD</span>
        </div>
      </div>
    </footer>
  </body>
</html>
