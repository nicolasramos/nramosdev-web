---
import Base from '../../../layouts/Base.astro';
import {getCollection} from 'astro:content';

const posts = (await getCollection('posts', ({data}) => data.lang === 'en' && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base lang="en" title="Blog — nramosdev" description="nramosdev blog posts: AI and tech analysis, no hype.">
  <section class="py-16">
    <p class="reveal font-mono text-sm text-muted">
      <span class="text-amber">nramos@dev</span>:<span class="text-fg">~</span>$ <span class="text-muted">ls ./blog</span>
    </p>
    <h1 class="reveal mt-5 font-mono text-4xl font-extrabold tracking-tight sm:text-5xl">Posts</h1>
    <p class="reveal mt-3 text-muted">Written analysis for every channel video.</p>
    <div class="mt-10 grid gap-4">
      {posts.map((post, i) => (
        <a
          href={`/en/blog/${post.id.replace(/^(es|en)-/, '')}`}
          class="reveal group block rounded-lg border border-line/70 bg-panel/60 p-6 transition hover:border-amber/50 hover:bg-panel sm:p-7"
          style={`animation-delay: ${0.05 + i * 0.05}s`}
        >
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[0.7rem] uppercase tracking-widest text-muted">
            <span class="text-amberdim" aria-hidden="true">[</span>
            <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', {day: '2-digit', month: '2-digit', year: 'numeric'})}</time>
            {post.data.duration && <span class="text-amberdim">· ▶ {post.data.duration}</span>}
            <span class="text-amberdim">]</span>
            {post.data.tags.slice(0, 3).map((tag) => <span class="text-amber">#{tag}</span>)}
          </div>
          <h2 class="mt-3 font-mono text-xl font-bold leading-snug transition group-hover:text-amber sm:text-2xl">
            <span class="mr-2 text-amberdim opacity-0 transition group-hover:opacity-100" aria-hidden="true">→</span>{post.data.title}
          </h2>
          <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-muted">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
