---
import Base from '../../../layouts/Base.astro';
import {getCollection} from 'astro:content';

const posts = (await getCollection('posts', ({data}) => data.lang === 'en' && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base lang="en" title="Blog — NRamosDev" description="NRamosDev blog posts: AI and tech analysis, no hype.">
  <section class="py-16">
    <h1 class="text-4xl font-black uppercase tracking-tight">Blog</h1>
    <p class="mt-3 text-neutral-400">Written analysis for every channel video.</p>
    <div class="mt-10 grid gap-6">
      {posts.map((post) => (
        <a href={`/en/blog/${post.id.replace(/\.en$/, '')}`} class="group block rounded-xl border border-white/10 bg-[#141414] p-8 transition hover:border-[#ff6a00]/60 hover:bg-[#181818]">
          <div class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-widest text-neutral-500">
            <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', {day: 'numeric', month: 'long', year: 'numeric'})}</time>
            {post.data.duration && <span class="rounded-full border border-white/15 px-2 py-0.5">▶ {post.data.duration}</span>}
          </div>
          <h2 class="mt-4 text-2xl font-black leading-snug transition group-hover:text-[#ff6a00]">{post.data.title}</h2>
          <p class="mt-3 line-clamp-2 text-neutral-400">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
