---
import Base from '../../layouts/Base.astro';
import {getCollection, render} from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({data}) => data.lang === 'es' && !data.draft);
  return posts.map((post) => ({params: {slug: post.id.replace(/^(es|en)-/, '')}, props: {post}}));
}

const {post} = Astro.props;
const {Content} = await render(post);

const slug = post.id.replace(/^(es|en)-/, '');
const canonical = `https://nramos.dev/blog/${slug}/`;
const ogImage = post.data.image ?? undefined;

// JSON-LD: Article + VideoObject (rich snippets en Google)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
      author: {'@type': 'Person', name: 'Nicolás Ramos', url: 'https://nramos.dev'},
      publisher: {'@type': 'Organization', name: 'NRamosDev', logo: {type: 'ImageObject', url: 'https://nramos.dev/favicon.svg'}},
      mainEntityOfPage: canonical,
      keywords: (post.data.tags ?? []).join(', '),
      inLanguage: 'es',
    },
  ],
};

if (post.data.videoId && post.data.videoId !== 'PENDIENTE') {
  jsonLd['@graph'].push({
    '@type': 'VideoObject',
    name: post.data.title,
    description: post.data.description,
    thumbnailUrl: `https://i.ytimg.com/vi/${post.data.videoId}/hqdefault.jpg`,
    uploadDate: post.data.pubDate.toISOString(),
    duration: post.data.duration || undefined,
    embedUrl: `https://www.youtube.com/embed/${post.data.videoId}`,
    contentUrl: post.data.videoUrl || `https://www.youtube.com/watch?v=${post.data.videoId}`,
  });
}

// Posts relacionados: misma etiqueta, excluyendo el actual
const related = (await getCollection('posts', ({data}) => data.lang === 'es' && !data.draft))
  .filter((p) => p.id !== post.id)
  .map((p) => ({post: p, shared: (p.data.tags ?? []).filter((t) => (post.data.tags ?? []).includes(t)).length}))
  .filter((r) => r.shared > 0)
  .sort((a, b) => b.shared - a.shared)
  .slice(0, 3)
  .map((r) => r.post);
---

<Base lang="es" title={`${post.data.title} — NRamosDev`} description={post.data.description} ogType="article" ogImage={ogImage} jsonLd={jsonLd}>
  <nav class="mx-auto max-w-3xl pt-8 font-mono text-xs text-muted" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a href="/" class="transition hover:text-amber">~</a></li>
      <li aria-hidden="true" class="text-line">/</li>
      <li><a href="/blog" class="transition hover:text-amber">blog</a></li>
      <li aria-hidden="true" class="text-line">/</li>
      <li aria-current="page" class="truncate text-fg">{slug}</li>
    </ol>
  </nav>

  <article class="mx-auto max-w-3xl py-10">
    <header class="mb-10 border-b border-line/70 pb-8">
      <p class="reveal font-mono text-xs uppercase tracking-[0.3em] text-amber">NRamosDev · Blog</p>
      <h1 class="reveal mt-4 font-mono text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">{post.data.title}</h1>
      <div class="reveal mt-5 flex flex-wrap items-center gap-3 font-mono text-xs uppercase tracking-widest text-muted">
        <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('es-ES', {day: '2-digit', month: '2-digit', year: 'numeric'})}</time>
        {post.data.duration && <span class="text-amberdim">· ▶ {post.data.duration}</span>}
        {post.data.tags.map((tag) => <span class="text-amber">#{tag}</span>)}
      </div>
    </header>

    {post.data.videoId && post.data.videoId !== 'PENDIENTE' && (
      <div class="reveal mb-12 overflow-hidden rounded-xl border border-line bg-panel">
        <div class="flex items-center gap-2 border-b border-line/70 bg-panel2/90 px-4 py-2 font-mono text-[0.7rem] uppercase tracking-widest text-muted">
          <span class="text-amber" aria-hidden="true">▶</span> youtube · {post.data.duration ?? 'vídeo'}
        </div>
        <div class="aspect-video">
          <iframe
            class="h-full w-full"
            src={`https://www.youtube.com/embed/${post.data.videoId}`}
            title={post.data.title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    )}

    <div class="prose max-w-none">
      <Content />
    </div>

    <div class="mt-16 rounded-xl border border-line/70 bg-panel/60 p-8 text-center">
      <p class="font-mono text-xl font-extrabold">([nr])</p>
      <p class="mt-3 text-sm text-muted">¿Te ha gustado? Suscríbete al canal para más análisis de IA en español.</p>
      <a href="https://www.youtube.com/@nramosdev" target="_blank" rel="noopener" class="mt-5 inline-block rounded-md bg-amber px-6 py-3 font-mono text-sm font-bold text-bg transition hover:bg-amber/85">
        Ver en YouTube
      </a>
    </div>
  </article>

  {related.length > 0 && (
    <section class="mx-auto max-w-3xl pb-16">
      <h2 class="mb-6 flex items-center gap-3 font-mono text-xs font-bold uppercase tracking-[0.3em] text-muted">
        <span class="text-amber" aria-hidden="true">▸</span> Artículos relacionados
      </h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {related.map((p) => (
          <a href={`/blog/${p.id.replace(/^(es|en)-/, '')}`} class="group block rounded-lg border border-line/70 bg-panel/60 p-5 transition hover:border-amber/50">
            <time class="font-mono text-[0.7rem] uppercase tracking-widest text-muted">{p.data.pubDate.toLocaleDateString('es-ES', {year: 'numeric', month: 'short'})}</time>
            <h3 class="mt-2 font-mono text-sm font-bold leading-snug transition group-hover:text-amber">{p.data.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
